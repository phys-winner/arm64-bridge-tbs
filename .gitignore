# Only publication sources are tracked; local game data stays ignored.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/arm64_bridge/
!/tools/
!/work/
/arm64_bridge/build*/
/arm64_bridge/dist/
/arm64_bridge/third_party/
/tools/*
!/tools/prepare_port.py
!/tools/port-patches.json
!/tools/android/
/work/*
!/work/research_cache/
/work/research_cache/*
!/work/research_cache/embed_whole_obb.py
!/work/research_cache/check_direct_readers.py
!/work/research_cache/obb_entry_fingerprints.json
**/__pycache__/
*.pyc
*.apk
*.apks
*.xapk
*.obb
*.so
*.dex
*.swf
*.jks
*.keystore
*.pk8
*.pem
*.p12
*.pfx
.env
